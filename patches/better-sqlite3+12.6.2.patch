+
+NODE_METHOD(Database::JS_progressHandler) {
+	Database* db = Unwrap<Database>(info.This());
+	REQUIRE_DATABASE_OPEN(db);
+	REQUIRE_DATABASE_NOT_BUSY(db);
+
+	if (info.Length() == 0 || info[0]->IsNull() || info[0]->IsUndefined()) {
+		sqlite3_progress_handler(db->db_handle, 0, NULL, NULL);
+		db->progress_handler_fn.Reset();
+		return;
+	}
+
+	REQUIRE_ARGUMENT_INT32(first, int interval);
+	REQUIRE_ARGUMENT_FUNCTION(second, v8::Local<v8::Function> fn);
+
+	if (interval <= 0) {
+		return ThrowRangeError("Expected the interval to be a positive integer");
+	}
+
+	UseIsolate;
+	db->progress_handler_isolate = isolate;
+	db->progress_handler_fn.Reset(isolate, fn);
+	sqlite3_progress_handler(db->db_handle, interval, ProgressHandlerCallback, db);
+}
+
+int Database::ProgressHandlerCallback(void* data) {
+	Database* db = static_cast<Database*>(data);
+	assert(!db->progress_handler_fn.IsEmpty());
+	v8::Isolate* isolate = db->progress_handler_isolate;
+	v8::HandleScope scope(isolate);
+
+	v8::MaybeLocal<v8::Value> result = db->progress_handler_fn.Get(isolate)->Call(
+		isolate->GetCurrentContext(),
+		v8::Undefined(isolate),
+		0, NULL
+	);
+
+	if (result.IsEmpty()) {
+		db->was_js_error = true;
+		return 1;
+	}
+
+	v8::Local<v8::Value> returnValue = result.ToLocalChecked();
+	return returnValue->BooleanValue(isolate) ? 1 : 0;
+}
