{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "jest"]
  },
  "include": [
    "server.js",
    "stats.js",
    "library/**/*.js",
    "tx/**/*.js",
    "utilities/**/*.js",
    "packages/**/*.js",
    "registry/**/*.js",
    "publisher/**/*.js",
    "shl/**/*.js",
    "token/**/*.js",
    "vcl/**/*.js",
    "xig/**/*.js",
    "npmprojector/**/*.js",
    "folder/**/*.js",
    "extension-tracker/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "static",
    "test-scripts",
    "tests"
  ]
}
