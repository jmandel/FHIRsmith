// Bench the IR engine in the ir-sqlite-v0 branch (~/hobby/fhirsmith-ir-pr)
// against v0 DBs (content-matched: SNOMED US 20260301, LOINC 2.82).
process.chdir('/home/jmandel/hobby/fhirsmith-ir-pr');
const fs = require('fs');
const R = '/home/jmandel/hobby/fhirsmith-ir-pr';
const { expandViaIR } = require(`${R}/tx/engine/orchestrator`);
const { bindIRScope } = require(`${R}/tx/engine/ir-bound-scope`);
const { SqliteV0FactoryProvider } = require(`${R}/tx/cs/cs-sqlite-v0`);
const { OperationContext } = require(`${R}/tx/operation-context`);
const { LanguageDefinitions } = require(`${R}/library/languages`);
const { I18nSupport } = require(`${R}/library/i18nsupport`);

const QUERIES = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const HOME = process.env.HOME;
const DBS = {
  'http://snomed.info/sct': `${HOME}/hobby/fhirsmith-v0-dbs/snomed-2026us-v0.db`,
  'http://loinc.org': `${HOME}/hobby/fhirsmith-v0-dbs/loinc-v0.db`,
};

function stats(ms) {
  const s = ms.slice().sort((a, b) => a - b);
  return { median: s[Math.floor(s.length / 2)], p95: s[Math.floor(s.length * 0.95)] || s[s.length - 1] };
}

async function main() {
  const langDefs = await LanguageDefinitions.fromFiles('tx/data');
  const i18n = new I18nSupport('translations', langDefs); await i18n.load();
  const op = new OperationContext('en', i18n);

  const factories = {};
  for (const [sys, path] of Object.entries(DBS)) {
    if (!fs.existsSync(path)) { console.error('missing', path); continue; }
    const f = new SqliteV0FactoryProvider(i18n, path);
    await f.load();
    factories[sys] = f;
  }

  const findProvider = async (system) => {
    const f = factories[system];
    if (!f) return null;
    const provider = await f.build(op, []);
    return await bindIRScope(provider, null);
  };

  async function runOne(q) {
    const p = q.params;
    try {
      const result = await expandViaIR(
        { resourceType: 'ValueSet', url: 'http://test/' + q.id, compose: q.compose },
        { findProvider,
          resolveValueSet: async () => null,
          resolveVersionAtDate: async () => null,
          activeOnly: !!p.activeOnly,
          offset: Math.max(p.offset || 0, 0),
          count: p.count >= 0 ? p.count : 1000,
          limit: (p.offset == null && p.count == null) ? 1000 : 0 });
      if (!result || !result.expansion) return { err: result ? (result.reason || 'no-expansion') : 'null' };
      const contains = result.expansion.contains || [];
      return { total: result.expansion.total, n: contains.length, codes: contains.map((c) => c.code).join(',') };
    } catch (e) {
      return { err: e.msgId || e.message || String(e) };
    }
  }

  const out = [];
  for (const q of QUERIES) {
    for (let i = 0; i < 3; i++) await runOne(q); // warmup
    const iters = q.params.count === 0 ? 15 : 25;
    const ms = []; let last;
    for (let i = 0; i < iters; i++) {
      const t = performance.now();
      last = await runOne(q);
      ms.push(performance.now() - t);
    }
    const s = stats(ms);
    out.push({ id: q.id, ir_ms: s.median, ir_p95: s.p95, ir_total: last.total, ir_n: last.n, ir_err: last.err || null, ir_codes: last.codes || null });
    console.log(`${last.err ? 'ERR:' + last.err : 'ok '} ${q.id}: IR ${s.median.toFixed(1)}ms (n=${last.n}, total=${last.total})`);
  }
  fs.writeFileSync(process.argv[3], JSON.stringify(out, null, 2));
  console.log('wrote', process.argv[3]);
}
main().catch((e) => { console.error(e); process.exit(1); });
