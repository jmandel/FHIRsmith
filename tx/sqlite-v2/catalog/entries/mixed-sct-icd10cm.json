            ]
          },
          {
            "system": "http://hl7.org/fhir/sid/icd-10-cm",
            "filter": [
              {"property": "concept", "op": "is-a", "value": "E11"}
            ]
          }
        ]
      }
    }
  },
  "patterns": [
    "first-page"
  ],
  "paging": {"count": 1000},
  "orderDefined": false,
